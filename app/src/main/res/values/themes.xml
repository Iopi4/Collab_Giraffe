<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GIRAFFEnew" parent="android:Theme.Material.Light.NoActionBar" >

    <!-- Primary brand color. -->
    <item name="android:colorPrimary">@color/purple_500</item>
    <item name="android:colorActivatedHighlight">@color/purple_700</item>
    <item name="android:colorPressedHighlight">@color/white</item>
    <!-- Secondary brand color. -->
    <item name="android:colorSecondary">@color/teal_200</item>
    <!-- Status bar color. -->
    <item name="android:statusBarColor">@color/Orange</item>
    <item name="android:windowActionBar">true</item>
    <item name="android:windowFullscreen">true</item> //Отключает верхнюю строку с зарядом батареи и временем. Делает полный экран запущенным приложением
    <!-- Customize your theme here. -->

    </style>

    <style name="Theme.GIRAFFEnew.NoActionBar">

        <item name="android:windowNoTitle">false</item>

    </style>

    <style name="Theme.GiraffeInterface.AppBarOverlay" parent="android:ThemeOverlay.Material.ActionBar" />

    <style name="Theme.GiraffeInterface.PopupOverlay" parent="android:ThemeOverlay.Material.Light" />

</resources>